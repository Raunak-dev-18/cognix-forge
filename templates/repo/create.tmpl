{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content repository new repo cx-form-page">
	<div class="cx-form-wrap">
		<header class="cx-form-head">
			<span class="cx-form-head__icon" aria-hidden="true">{{svg "octicon-repo" 20}}</span>
			<div>
				<p class="cx-eyebrow"><span class="cx-eyebrow__mark" aria-hidden="true">✳</span> {{AppName}}</p>
				<h1>{{ctx.Locale.Tr "new_repo.title"}}</h1>
				{{if not $.DisableMigrations}}<p class="cx-form-head__lede">{{ctx.Locale.Tr "repo.new_repo_helper" (print AppSubUrl "/repo/migrate")}}</p>{{end}}
			</div>
		</header>
		<form class="ui form cx-form" action="{{.Link}}" method="post">
			{{if or .CanCreateRepo .Orgs}}
				{{template "base/alert" .}}

				{{if and (not .CanCreateRepo) (ne .MaxCreationLimit 0)}}
					<div class="ui negative message">
						<p>{{ctx.Locale.TrN .MaxCreationLimit "repo.form.reach_limit_of_creation_1" "repo.form.reach_limit_of_creation_n" .MaxCreationLimit}}</p>
					</div>
				{{end}}
				<section class="cx-form-card">
					<fieldset class="cx-form-basic">
						{{template "repo/create_basic" .}}
					</fieldset>
				</section>

				<section class="cx-form-card">
					<fieldset>
						<legend>
							{{ctx.Locale.Tr "repo.new_from_template"}}
							<span class="help">{{ctx.Locale.Tr "repo.new_from_template_description"}}</span>
						</legend>
						{{template "repo/create_from_template" .}}
					</fieldset>
				</section>

				<div id="non_template">
					<section class="cx-form-card">
						<fieldset>
							<legend>{{ctx.Locale.Tr "repo.auto_init"}}</legend>
							{{template "repo/create_init" .}}
						</fieldset>
					</section>

					<section class="cx-form-card">
						<fieldset>
							<legend>{{ctx.Locale.Tr "repo.new_advanced"}}</legend>
							<details><summary>{{ctx.Locale.Tr "repo.new_advanced_expand"}}</summary>
								{{template "repo/create_advanced" .}}
							</details>
						</fieldset>
					</section>
				</div>
				<div class="cx-form-foot">
					<button class="ui primary button cx-btn-lg">
						{{ctx.Locale.Tr "repo.create_repo"}}
					</button>
				</div>
			{{else}}
				<div class="ui negative message">
					{{ctx.Locale.Tr "repo.form.cannot_create"}}
				</div>
			{{end}}
		</form>
	</div>
</div>
{{template "base/footer" .}}
