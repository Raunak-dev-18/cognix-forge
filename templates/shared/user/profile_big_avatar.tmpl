{{if .IsHTMX}}
	{{template "base/alert" .}}
{{end}}

{{$showFollow := and .IsSigned (ne .SignedUserID .ContextUser.ID)}}
{{$isSelf := and .IsSigned (eq .SignedUserID .ContextUser.ID)}}

<div id="profile-avatar-card" class="ui card cx-profile-card">
	<div id="profile-avatar" class="content tw-flex">
	{{if $isSelf}}
		<a class="image" href="{{AppSubUrl}}/user/settings#avatar-settings" data-tooltip-content="{{ctx.Locale.Tr "user.change_avatar"}}">
			{{/* the size doesn't take affect (and no need to take affect), image size(width) should be controlled by the parent container since this is not a flex layout*/}}
			{{ctx.AvatarUtils.Avatar .ContextUser 296}}
		</a>
	{{else}}
		<span class="image">
			{{ctx.AvatarUtils.Avatar .ContextUser 296}}
		</span>
	{{end}}
	</div>
	<div class="content tw-break-anywhere profile-avatar-name">
		{{if .ContextUser.FullName}}<span class="header">{{.ContextUser.FullName}}</span>{{end}}
		<span class="username">{{.ContextUser.Name}}{{if .ContextUser.GetPronouns .IsSigned}} · {{.ContextUser.GetPronouns .IsSigned}}{{end}}</span>
	</div>
	{{if $.RenderedDescription}}
		<div class="content cx-profile-bio render-content markup">{{$.RenderedDescription}}</div>
	{{end}}
	<div class="main-actions button-row">
		{{if $showFollow}}
			{{if .IsFollowing}}
				<button class="secondary button tw-flex-1" hx-post="{{.ContextUser.HomeLink}}?action=unfollow" hx-target="#profile-avatar-card" hx-indicator="#profile-avatar-card">
					{{svg "octicon-person"}} {{ctx.Locale.Tr "user.unfollow"}}
				</button>
			{{else}}
				<button class="primary button tw-flex-1" hx-post="{{.ContextUser.HomeLink}}?action=follow" hx-target="#profile-avatar-card" hx-indicator="#profile-avatar-card">
					{{svg "octicon-person"}} {{ctx.Locale.Tr "user.follow"}}
				</button>
			{{end}}
		{{else if $isSelf}}
			<a class="ui basic button tw-flex-1" href="{{AppSubUrl}}/user/settings">{{ctx.Locale.Tr "profile.edit.link"}}</a>
		{{end}}
		{{template "shared/user/actions_menu" .}}
	</div>
	<div class="content cx-profile-follow">
		<a class="muted" href="{{.ContextUser.HomeLink}}?tab=followers">{{svg "octicon-people" 16}}{{ctx.Locale.TrPluralString .NumFollowers "counters.n_followers" .NumFollowers}}</a>
		<span aria-hidden="true">·</span>
		<a class="muted" href="{{.ContextUser.HomeLink}}?tab=following">{{ctx.Locale.TrPluralString .NumFollowing "counters.n_following" .NumFollowing}}</a>
	</div>
	<div class="extra content tw-break-anywhere">
		<ul>
			{{if .ContextUser.Location}}
				<li>
					{{svg "octicon-location"}}
					<span class="tw-flex-1">{{.ContextUser.Location}}</span>
					{{if .ContextUserLocationMapURL}}
						<a href="{{.ContextUserLocationMapURL}}" rel="nofollow noreferrer" data-tooltip-content="{{ctx.Locale.Tr "user.show_on_map"}}">
							{{svg "octicon-link-external"}}
						</a>
					{{end}}
				</li>
			{{end}}
			{{if .ShowUserEmail}}
				<li>
					{{svg "octicon-mail"}}
					<a class="tw-flex-1" href="mailto:{{.ContextUser.Email}}" rel="nofollow">{{.ContextUser.Email}}</a>
					{{if $isSelf}}
						<a href="{{AppSubUrl}}/user/settings#privacy-user-settings">
							<i data-tooltip-content="{{ctx.Locale.Tr "user.email_visibility.limited"}}">
								{{svg "octicon-unlock"}}
							</i>
						</a>
					{{end}}
				</li>
			{{end}}
			{{if .ContextUser.Website}}
				<li>
					{{svg "octicon-link"}}
					<a target="_blank" rel="noopener noreferrer me" href="{{.ContextUser.Website}}">{{.ContextUser.Website}}</a>
				</li>
			{{end}}
			{{range .OpenIDs}}
				{{if .Show}}
					<li>
						{{svg "octicon-link"}}
						<a target="_blank" rel="noopener noreferrer" href="{{.URI}}">{{.URI}}</a>
					</li>
				{{end}}
			{{end}}
			<li>
				{{svg "octicon-calendar"}}
				<span>{{ctx.Locale.Tr "user.joined_on" (DateUtils.AbsoluteShort .ContextUser.CreatedUnix)}}</span>
			</li>
			{{if .Funding}}
			<li>
				{{template "shared/donation_button" .}}
			</li>
			{{end}}
		</ul>
	</div>
	{{if and .Orgs .HasOrgsVisible}}
	<div class="content cx-profile-section">
		<h3>{{ctx.Locale.Tr "organization"}}</h3>
		<ul class="user-orgs">
		{{range .Orgs}}
			{{if (or .Visibility.IsPublic (and ($.SignedUser) (or .Visibility.IsLimited (and (.HasMemberWithUserID ctx $.SignedUserID) .Visibility.IsPrivate) ($.IsAdmin))))}}
			<li>
				<a href="{{.HomeLink}}" data-tooltip-content="{{.Name}}">
					{{ctx.AvatarUtils.Avatar .}}
				</a>
			</li>
			{{end}}
		{{end}}
		</ul>
	</div>
	{{end}}
	{{if .Badges}}
	<div class="content cx-profile-section">
		<h3>Achievements</h3>
		<ul class="user-badges">
		{{range .Badges}}
			<li>
				<img width="64" height="64" src="{{.ImageURL}}" alt="{{.Description}}" data-tooltip-content="{{.Description}}">
			</li>
		{{end}}
		</ul>
	</div>
	{{end}}
</div>

{{if .Funding}}
	{{template "shared/funding" .}}
{{end}}
