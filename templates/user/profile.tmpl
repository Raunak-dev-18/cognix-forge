{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content user profile">
	<div class="secondary-nav cx-profile-nav"><div class="ui container">{{template "user/overview/header" .}}</div></div>
	<div class="ui container">
		{{template "base/alert" .}}
		<div class="ui stackable grid">
			<div class="ui four wide column">
				{{template "shared/user/profile_big_avatar" .}}
			</div>
			<div class="ui twelve wide column tw-mb-4">
				{{if eq .TabName "activity"}}
					{{if eq .SignedUserID .ContextUser.ID}}
					<p id="visibility-hint">
						{{if .ContextUser.KeepActivityPrivate}}
							{{ctx.Locale.Tr "user.public_activity.visibility_hint.self_private" (print AppSubUrl "/user/settings#keep-activity-private")}}
						{{else}}
							{{if eq .ContextUser.Visibility 2}}
								{{ctx.Locale.Tr "user.public_activity.visibility_hint.self_private_profile" (print AppSubUrl "/user/settings#visibility-setting")}}
							{{else}}
								{{ctx.Locale.Tr "user.public_activity.visibility_hint.self_public" (print AppSubUrl "/user/settings#keep-activity-private")}}
							{{end}}
						{{end}}
					</p>
					{{else}}
						{{if .IsAdmin}}
						<div id="visibility-hint" class="ui info message">
							{{if or .ContextUser.KeepActivityPrivate (eq .ContextUser.Visibility 2)}}
								{{ctx.Locale.Tr "user.public_activity.visibility_hint.admin_private"}}
							{{else}}
								{{ctx.Locale.Tr "user.public_activity.visibility_hint.admin_public"}}
							{{end}}
						</div>
						{{else}}
							{{if .ContextUser.KeepActivityPrivate}}
								<p id="visibility-hint">{{ctx.Locale.Tr "user.disabled_public_activity"}}</p>
							{{end}}
						{{end}}
					{{end}}
					{{if or .IsAdmin (eq .SignedUserID .ContextUser.ID) (not .ContextUser.KeepActivityPrivate)}}
						{{template "user/heatmap" .}}
						{{template "user/dashboard/feeds" .}}
					{{end}}
				{{else if eq .TabName "stars"}}
					<div class="stars">
						{{template "shared/repo_search" .}}
						{{template "explore/repo_list" .}}
						{{template "base/paginate" .}}
					</div>
				{{else if eq .TabName "following"}}
					{{template "repo/user_cards" .}}
				{{else if eq .TabName "followers"}}
					{{template "repo/user_cards" .}}
				{{else if eq .TabName "overview"}}
					{{if .ProfileReadme}}
					<div id="readme_profile" class="cx-profile-readme {{if not .IsProfileReadmePlain}}markup{{end}}">
					{{if .IsProfileReadmePlain}}
						<pre>{{.ProfileReadme}}</pre>
					{{else}}
						{{.ProfileReadme}}
					{{end}}
					</div>
					{{end}}
					{{if .PopularRepos}}
					<section class="cx-profile-block" aria-labelledby="popular-repos-title">
						<div class="cx-profile-block__head">
							<h2 id="popular-repos-title">{{if .ProfileReadme}}{{ctx.Locale.Tr "user.repositories"}}{{else}}Popular repositories{{end}}</h2>
							<a href="{{.ContextUser.HomeLink}}?tab=repositories">View all {{svg "octicon-arrow-right" 14}}</a>
						</div>
						<div class="cx-pin-grid">
							{{range .PopularRepos}}
							<article class="cx-pin">
								<div class="cx-pin__title">
									{{if .IsPrivate}}{{svg "octicon-lock" 16}}{{else}}{{svg "octicon-repo" 16}}{{end}}
									<a href="{{.Link}}">{{.Name}}</a>
									<span class="cx-pill">{{if .IsPrivate}}{{ctx.Locale.Tr "repo.desc.private"}}{{else}}{{ctx.Locale.Tr "filter.public"}}{{end}}</span>
								</div>
								<p class="cx-pin__desc">{{if .Description}}{{.Description}}{{else}}<span class="cx-muted">{{ctx.Locale.Tr "repo.no_desc"}}</span>{{end}}</p>
								<div class="cx-pin__meta">
									{{if .IsFork}}<span>{{svg "octicon-repo-forked" 14}} {{ctx.Locale.Tr "repo.fork"}}</span>{{end}}
									<a class="muted" href="{{.Link}}/stars">{{svg "octicon-star" 14}} {{.NumStars}}</a>
									{{if .NumForks}}<a class="muted" href="{{.Link}}/forks">{{svg "octicon-repo-forked" 14}} {{.NumForks}}</a>{{end}}
								</div>
							</article>
							{{end}}
						</div>
					</section>
					{{end}}
					{{if or .IsAdmin (eq .SignedUserID .ContextUser.ID) (not .ContextUser.KeepActivityPrivate)}}
					<section class="cx-profile-block" aria-label="{{ctx.Locale.Tr "user.activity"}}">
						{{template "user/heatmap" .}}
						{{if .Feeds}}
						<div class="cx-profile-block__head"><h2>{{ctx.Locale.Tr "user.activity"}}</h2></div>
						{{template "user/dashboard/feeds" .}}
						{{template "base/paginate" .}}
						{{end}}
					</section>
					{{end}}
				{{else if and FederationEnabled (eq .TabName "feed")}}
					{{if eq .SignedUserID .ContextUser.ID}}
						{{if .FollowingFeeds}}
							{{template "user/dashboard/ap_feed" .}}
						{{else}}
							{{template "user/dashboard/ap_feed_guide" .}}
						{{end}}
					{{end}}
				{{else}}
					{{template "shared/repo_search" .}}
					{{template "explore/repo_list" .}}
					{{template "base/paginate" .}}
				{{end}}
			</div>
		</div>
	</div>
</div>

{{template "shared/admin/user_delete" .}}

{{template "base/footer" .}}
